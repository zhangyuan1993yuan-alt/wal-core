# Maven
/target/
*.class
*.jar

# WAL 运行期产物（根目录锚定：避免误伤 src 下的同名 Java 包）
*.wal
*.idx
*.idx.bak
*.tmp
/wal.meta
/LOCK
/partitions/
/snapshots/
/plugin/
*.cursor
*.state

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
nbproject/

# OS
.DS_Store
Thumbs.db

# 日志
*.log
hs_err_pid*.log

# AI 工具工作数据：会话记忆随仓库走（换环境 clone 后自动就位），其余不入库
# 规则必须根锚定；改完用 git ls-files --others --ignored --exclude-standard 复核
/.workbuddy/*
!/.workbuddy/memory/

# 归档制品白名单：上面的 *.jar 规则会误伤随仓库分发的发布 jar
!/archive/*.jar
